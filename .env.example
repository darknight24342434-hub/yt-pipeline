# Optional. Required for automatic translation, high-quality summary,
# deep analysis, and LLM-based highlight selection.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Strongly recommended before LAN or public tunnel exposure.
# Any non-empty value enables login protection.
APP_ACCESS_TOKEN=

# Optional. If YouTube blocks a video that needs your browser session,
# choose one of these yt-dlp cookie sources.
# YTDLP_COOKIES_FILE=C:\path\to\cookies.txt
# YTDLP_COOKIES_BROWSER=chrome

# Optional local transcription fallback when no captions exist.
WHISPER_MODEL=small

# Optional storage override.
# YT_ANALYZER_DATA_DIR=D:\path\to\yt-pipeline-data

# Optional. Path or command name for ffmpeg if it is not on PATH.
# FFMPEG_PATH=ffmpeg

# Optional. Name of the session cookie set after login.
# AUTH_COOKIE_NAME=yt_analyzer_session
